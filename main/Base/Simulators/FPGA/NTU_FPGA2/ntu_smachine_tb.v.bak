`timescale 1ns / 1ns

// todo
// test transmission
module ntu_smachine_tb ();

// Declare signals to connect to the UART module
reg RST;
reg CLK;
reg rx_clk;
wire rx_dv;
wire rx_serial;
wire [7:0] rx_data_out;
reg [7:0] tx_data_in;
reg tx_dv;
wire tx_active;
wire tx_serial;
wire [31:0] o_Status;

parameter UALRFREC = 1152000;
parameter CLOCKWIDTH = 8;
parameter CLOCKWIDTH_HALF = 4;
parameter CLOCKFQ = 1000000000/CLOCKWIDTH;
parameter UART_TIME = 1000000000/UALRFREC;
parameter UART_TIME11 = 1000000000/UALRFREC*11;

// we need transmitter and receiver to tset state machine (ntu_smachine)
ntu_smachine #(.UART_CLKS_PER_BIT(CLOCKFQ/UALRFREC)) ntuS 
(
.CLK     (CLK),        // Connect to your system clock wire
.RST         (RST),        // Connect to your system reset wire
.i_Rx_Serial (tx_serial),      // Connect to the incoming serial data wire
.o_Tx_Serial     (rx_serial),  // Connect to the wire for the data valid signal
.o_Status   (o_Status)         // Connect to the wire for the received byte
);
receiver #(.CLKS_PER_BIT(CLOCKFQ/UALRFREC)) r2 ( //  a receiver accept a data from the state machine. This is used to check the output of the state machine.
      // Inputs
      .i_Clock     (CLK),        // Connect to your system clock wire
      .RST         (RST),        // Connect to your system reset wire
      .i_Rx_Serial (rx_serial),      // Connect to the incoming serial data wire
      // Outputs
      .o_Rx_DV     (rx_dv),  // Connect to the wire for the data valid signal
      .o_Rx_Byte   (rx_data_out)         // Connect to the wire for the received byte
);
transmitter #(.CLKS_PER_BIT(CLOCKFQ/UALRFREC) // 50 MHz, a transmitter send a data to the state machine
) t0(
      .i_Clock(CLK),
      .RST(RST),
      .i_Tx_DV(tx_dv),
      .i_Tx_Byte(tx_data_in), 
      .o_Tx_Active(tx_active),
      .o_Tx_Serial(tx_serial),
      .o_Tx_Done()
);


always
begin
      #CLOCKWIDTH_HALF CLK <= ~CLK; // clock generation, half period
end
always
begin
      #UART_TIME rx_clk <= ~rx_clk;
end

parameter [7:0] OP_NONE = 0; // Send: 1, Res: 0.
parameter [7:0] OP_MOV_rA = 1; // Send: 1, Res: 0.
parameter [7:0] OP_MOV_rB = 2; // Send: 1, Res: 0.
parameter [7:0] OP_ADD_rB2rA = 3; // Send: 0, Res: 0.
parameter [7:0] OP_MUL_rB2rA = 4; // Send: 0, Res: 0.
parameter [7:0] OP_INC_rA = 5; // Send: 0, Res: 0.
parameter [7:0] OP_INC_rB = 6; // Send: 0, Res: 0.
parameter [7:0] OP_READ_rA = 31; // Send: 0, Res: 1.
parameter [7:0] OP_READ_rB = 32; // Send: 0, Res: 1.
parameter [7:0] OP_MOV_rA64 = 51; // Send: 0, Res: 1.
parameter [7:0] OP_MOV_rA64rB = 52; // Send: 0, Res: 0.
parameter [7:0] OP_MOV_rA64rX = 53; // Send: 0, Res: 0.
parameter [7:0] OP_MOV_rX64rA = 54; // Send: 0, Res: 0.
parameter [7:0] OP_MOV_rB64rA = 56; // Send: 0, Res: 0.
parameter [7:0] OP_MOV_rS64rA = 57; // Send: 0, Res: 0.
parameter [7:0] OP_READ_rA64 = 55; // Send: 0, Res: 8.
parameter [7:0] OP_ADD_rBrA64FP = 61; // Send: 0, Res: 0.
parameter [7:0] OP_MUL_rBrA64FP = 62; // Send: 0, Res: 0.

reg [63:0] fp64;
reg [63:0] None8;
reg [63:0] fp64rx = 0;
reg [7:0] recState;
reg [7:0] recCount;
integer i;

always @(posedge CLK) begin
      if(recState == 1) begin
            if(recCount != 8)begin
                  if(rx_dv) begin
                        fp64rx[recCount*8+:8] <=rx_data_out;
                        recCount <= recCount + 1;
                  end
            end
            else begin
                  recCount <= 0;
                  recState <= 0;
            end
      end
end
// test for transmitter
logic [7: 0] data_array [];
initial begin 
      fp64 = 64'b0100000000010000100110001001001101110100101111000110101001111111; // 4.149
      None8 = 64'd0;
      data_array = {OP_MOV_rA, 8'd12, OP_INC_rA, OP_READ_rA, OP_MOV_rB, 5, OP_ADD_rB2rA, OP_MUL_rB2rA,
                  OP_READ_rA, OP_MOV_rA64, 
      8'h40,   // Element 0
      8'h10,   // Element 1
      8'h98,   // Element 2
      8'h93,   // Element 3
      8'h74,   // Element 4
      8'hBC,   // Element 5
      8'h6A,   // Element 6
      8'h7F    // Element 7
      , OP_READ_rA64,
      0,0,0,0,0,0,0,0, 
      OP_MOV_rA64rB, OP_ADD_rBrA64FP,OP_MUL_rBrA64FP, OP_READ_rA64, 
      0,0,0,0,0,0,0,0
      ,0};
      #UART_TIME11;

      for (i = 0; i <data_array.size() ; i = i + 1) begin
            tx_data_in <= data_array[i];
            if(data_array[i] == OP_READ_rA64) begin
                  recCount <= 0;
                  recState <= 1;
            end
            tx_dv <= 1;
            #5
            tx_dv <= 0;
            #UART_TIME11;
      end
      
      $stop;
      
end
// Initialize signals
initial begin
      RST <= 1; // Reset active-high
      CLK <= 0;
      // Apply reset
      #100 RST <= 0;

      // Test Case 1: Transmit and receive a single character
      #1000 RST <= 1;
      #100 RST <= 0;

      // End simulation
end

endmodule
